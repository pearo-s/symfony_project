<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Blog{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ asset('styles/exchange_rate_widget.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/main_post_index.css') }}">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block stylesheets %}
    {% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/"><b>Home</b></a>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            {% if is_granted('IS_AUTHENTICATED_FULLY') and is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="{{ path('index_user') }}">Admin panel</a>
                </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="{{ path('main_index_post') }}">Posts</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="{{ path('main_index_product') }}">Products</a>
            </li>
        </ul>

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <img src="{{ app.user.thumbnail is empty ? asset('uploads/no_avatar.png') : asset('uploads/user/' ~ app.user.thumbnail) }}" alt="User Avatar" class="rounded me-2" width="70" height="60">
                            <b>{{ app.user.username }}</b>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" aria-current="page" href="{{ path('main_show_user', {id: app.user.id}) }}">My profile</a>
                            </li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        {% else %}
            <div class="ms-auto">
                <a class="dropdown-item" href="{{ path('app_login') }}">Login</a>
            </div>
        {% endif %}

    </div>
</nav>

{% block body %}{% endblock %}

<script>
    function confirmAction() {
        return confirm("Are you sure?");
    }
</script>
</body>
</html>
