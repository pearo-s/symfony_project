<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">

        {% for product in pagination %}

            <div class="col">
                <div class="card h-100">
                    <a href="{{ path('show_product', {id: product.id}) }}">
                        <img src="{{ product.productImages is not empty ? asset('uploads/product' ~ product.productImages[0].thumbnail) : asset('uploads/no_image.png') }}" class="card-img-top"
                             data-images="{% for image in product.productImages %}{{ ' /uploads/product' ~ image.thumbnail }}{% endfor %}"
                             alt="...">
                    </a>

                    <div class="card-body">
                        <h5 class="card-title">{{ product.price }}$</h5>
                        <p class="card-text">{{ product.name }}</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-body-secondary">{{ product.createdAt|date('d.m.Y') }}</small>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="d-flex justify-content-lg-begin gap-2">
                                <a class="btn btn-sm btn-success" href="">Edit</a>

                                <form action="{{ path('delete_product', {'id': product.id}) }}" method="post">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                    <button type="submit" onclick="return confirmAction()" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        {% endfor %}
    </div>
</div>

<div class="mt-5 ms-3">
    {{ knp_pagination_render(pagination) }}
</div>

<script>
    document.querySelectorAll('.card-img-top').forEach(img => {
        let images = img.dataset.images.trim().split(' ');
        console.log(images);
        if (images.length > 1) {
            let index = 0;
            let interval;

            img.addEventListener('mouseenter', function () {
                interval = setInterval(() => {
                    index = (index + 1) % images.length;
                    this.src = images[index];
                }, 700);
            });

            img.addEventListener('mouseleave', function () {
                clearInterval(interval);
                this.src = images[0];
            });
        }
    });
</script>