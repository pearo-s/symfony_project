{% extends 'admin.base.html.twig' %}

{% block body %}
    <div class="container">

        {% if product %}
            <div class="row">
                <div class="col-12 mt-5">
                    <h1 class="text-center h2 my-3">Product editing</h1>
                </div>
            </div>

            {{ form_start(form, {'attr': {'class': 'mt-5'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
            {{ form_row(form.price) }}
            {{ form_row(form.colour) }}
            {{ form_row(form.quantity) }}
            {{ form_row(form.category) }}

            <div class="form-group">
                {% if productImages|length > 0 %}
                    <div class="d-flex flex-wrap">
                        {% for productImage in productImages %}

                            <div class="mt-3 mb-3 me-3 text-center">

                                <div class="mb-3">
                                    <img src="{{ asset('uploads/product/' ~ productImage.thumbnail) }}"
                                         class="img-thumbnail"
                                         alt="current_image"
                                         width="200">
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" name="removeFiles[]"
                                           value="{{ productImage.id }}" id="productImageCheckBox-{{ productImage.id }}">
                                    <label class="form-check-label" for="productImageCheckBox-{{ productImage.id }}">Delete image</label>
                                </div>

                            </div>

                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {{ form_row(form.images) }}
            {{ form_row(form.update) }}
            {{ form_row(form._token) }}

            {{ form_end(form, {'render_rest': false}) }}

        {% else %}

            <div class="d-flex justify-content-center align-items-start vh-100 pt-5">
                <h2><i class="text-danger font-italic">Product does not exist</i></h2>
            </div>

        {% endif %}
    </div>
{% endblock %}
