{% extends 'base.html.twig' %}

{% block body %}

    <div class="container">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if post %}

            {% if is_granted('IS_AUTHENTICATED_FULLY') and app.user.id == post.user.id %}
                <div class="row mt-5">
                    <div class="d-flex justify-content-lg-begin gap-2">
                        <a class="btn btn-success" href="{{ path('main_edit_post', {id: post.id}) }}">Edit</a>

                        <form action="{{ path('main_delete_post', {'id': post.id}) }}" method="post">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                            <button type="submit" onclick="return confirmAction()" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}

            <div class="row">
                <div class="col-12">
                    <i><h1 class="text-center h2 my-3">{{ post.title }}</h1></i>
                    Author: <a href="{{ path('main_show_user', {id: post.User.id}) }}">{{ post.User.getUsername }}</a>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12">
                    <i><h4>{{ post.text|raw }}</h4></i>
                    {% if post.image %}
                        <img src="{{ asset('uploads/post/' ~ post.image) }}" class="mt-5" width="100%"
                             alt="{{ post.title }}">
                    {% endif %}
                    <div class="mt-3">Published on: {{ post.getCreatedAt.format('Y-m-d') }}</div>
                </div>
            </div>

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                {{ form_start(form, {'action': path('create_commentary', {'id': post.id}), 'method': 'POST', 'attr': {'class': 'w-50 mt-5'}}) }}
                {{ form_widget(form) }}
                {{ form_end(form) }}
            {% endif %}

            {% if commentaries is not empty %}

                <div class="btn-group ms-1 mt-5">
                    <button type="button" class="btn btn-outline-primary sort-btn" data-sort="date">newest</button>
                    <button type="button" class="btn btn-outline-primary sort-btn" data-sort="likes">top</button>
                </div>

                {# Commentary list #}
                <div id="commentaries-container">
                    {% include 'main/post/index_sort_commentaries.html.twig' %}
                </div>

            {% else %}
                <h5 class="mt-5"><i class="text-danger font-italic">There is no commentaries on this post</i></h5>
            {% endif %}

        {% else %}
            <div class="d-flex justify-content-center align-items-start vh-100 pt-5">
                <h2><i class="text-danger font-italic">Post does not exist</i></h2>
            </div>
        {% endif %}
    </div>

    <script>

        //ajax likes
        document.getElementById("commentaries-container").addEventListener("click", function (event) {
            if (event.target.closest(".like-button")) {
                const button = event.target.closest(".like-button");
                let commentaryId = button.dataset.commentaryId;
                let heartIcon = button.querySelector("i");
                let likesCount = button.nextElementSibling;

                fetch(`/commentaries/${commentaryId}/like`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            heartIcon.classList.toggle("bi-heart-fill", data.liked);
                            heartIcon.classList.toggle("bi-heart", !data.liked);
                            heartIcon.classList.toggle("text-danger", data.liked);
                            likesCount.textContent = data.likes_count;
                        }
                    })
                    .catch(error => console.error("Ошибка:", error));
            }
        });

        //ajax commentary sorting
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".sort-btn").forEach(button => {
                button.addEventListener("click", function () {

                    document.querySelectorAll(".sort-btn").forEach(btn => {
                        btn.classList.remove('active');
                    });

                    this.classList.add('active');

                    const sortType = this.getAttribute("data-sort");
                    const postId = "{{ post.id }}";

                    fetch(`/posts/${postId}/commentaries/sort/${sortType}`, {
                        method: "GET",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    })
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById("commentaries-container").innerHTML = html;
                        })
                        .catch(error => console.error("Error:", error));
                });
            });
        });

        document.getElementById("commentaries-container").addEventListener("click", function (event) {
            // Edit button processing
            if (event.target.closest(".edit-commentary-button")) {
                const button = event.target.closest(".edit-commentary-button");
                const commentaryId = button.closest(".card").dataset.commentaryId;
                const commentaryText = button.closest(".card-body").querySelector(".commentary-text");
                const editForm = button.closest(".card-body").querySelector(".edit-commentary-form");
                const editButton = button.closest(".card-body").querySelector(".edit-commentary-button");
                const deleteButton = button.closest(".card-body").querySelector(".delete-commentary-button");

                // Hide comment text and show edit form
                commentaryText.style.display = "none";
                editButton.style.display = "none";
                deleteButton.style.display = "none";

                //Show edit form
                editForm.style.display = "block";
            }

            // Cancel button processing
            if (event.target.closest(".cancel-edit-button")) {
                const button = event.target.closest(".cancel-edit-button");
                const commentaryText = button.closest(".card-body").querySelector(".commentary-text");
                const editForm = button.closest(".card-body").querySelector(".edit-commentary-form");
                const editButton = button.closest(".card-body").querySelector(".edit-commentary-button");
                const deleteButton = button.closest(".card-body").querySelector(".delete-commentary-button");

                // Hide edit form and show comment text
                editForm.style.display = "none";

                //Show commentary text, edit and delete buttons
                commentaryText.style.display = "block";
                editButton.style.display = "inline-block";
                deleteButton.style.display = "inline-block";
            }

            // Delete button processing
            if (event.target.closest(".delete-commentary-button")) {
                const button = event.target.closest(".delete-commentary-button");
                if (confirmAction()) {
                    const commentaryId = button.closest(".card").dataset.commentaryId;

                    fetch(`/commentaries/${commentaryId}`, {
                        method: "DELETE",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                button.closest(".card").remove();
                            }
                        })
                        .catch(error => console.error("Error:", error));
                }
            }
        });

        // Editing form submission processing
        document.getElementById("commentaries-container").addEventListener("submit", function (event) {
            if (event.target.closest(".edit-commentary-form")) {

                event.preventDefault();

                const button = event.target.closest(".edit-commentary-form");
                const commentaryId = button.dataset.commentaryId;
                const formData = new FormData(button);

                fetch(`/commentaries/${commentaryId}/edit`, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const commentaryText = button.closest(".card-body").querySelector(".commentary-text");
                            const editForm = button.closest(".card-body").querySelector(".edit-commentary-form");
                            const editButton = button.closest(".card-body").querySelector(".edit-commentary-button");
                            const deleteButton = button.closest(".card-body").querySelector(".delete-commentary-button");

                            // Update commentary text
                            commentaryText.innerHTML = data.text;

                            //Show commentary text, edit and delete buttons
                            commentaryText.style.display = "block";
                            editForm.style.display = "none";
                            editButton.style.display = "inline-block";
                            deleteButton.style.display = "inline-block";
                        }
                    })
                    .catch(error => console.error("Error:", error));
            }

        });
    </script>

{% endblock %}