{% extends 'base.html.twig' %}

{% block body %}

    <div class="container">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if post %}

            {% if is_granted('IS_AUTHENTICATED_FULLY') and app.user.id == post.user.id %}
                <div class="row mt-5">
                    <div class="d-flex justify-content-lg-begin gap-2">
                        <a class="btn btn-success" href="{{ path('main_edit_post', {id: post.id}) }}">Edit</a>

                        <form action="{{ path('main_delete_post', {'id': post.id}) }}" method="post">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                            <button type="submit" onclick="return confirmAction()" class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}

            <div class="row">
                <div class="col-12">
                    <i><h1 class="text-center h2 my-3">{{ post.title }}</h1></i>
                    Author: <a href="{{ path('main_show_user', {id: post.User.id}) }}">{{ post.User.getUsername }}</a>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12">
                    <i><h4>{{ post.text|raw }}</h4></i>
                    {% if post.image %}
                        <img src="{{ asset('uploads/post/' ~ post.image) }}" class="mt-5" width="100%" alt="{{ post.title }}">
                    {% endif %}
                    <div class="mt-3">Published on: {{ post.getCreatedAt.format('Y-m-d') }}</div>
                </div>
            </div>

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                {{ form_start(form, {'action': path('create_commentary', {'id': post.id}), 'method': 'POST', 'attr': {'class': 'w-50 mt-5'}}) }}
                {{ form_widget(form) }}
                {{ form_end(form) }}
            {% endif %}

            {% if commentaries is not empty %}
                {% for commentary in commentaries %}
                    {% if commentary.isModerated %}
                        <div class="card w-50 shadow-sm mt-5 mb-5">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <img src="{{ commentary.User.thumbnail ? asset('uploads/user/' ~ commentary.User.thumbnail) : asset('uploads/no_avatar.png') }}"
                                         width="70" height="60" class="rounded me-3" alt="User avatar">
                                    <div>
                                        <a href="{{ path('main_show_user', {id: commentary.user.id}) }}" class="link-{{ 'ROLE_ADMIN' in commentary.User.getRoles ? "danger" : "success" }}"><h5 class="card-title mb-0">{{ post.User.Id == commentary.User.Id ? "(H)" : "" }}{{ commentary.getUser.username }}</h5></a>
                                        <small class="text-muted">{{ commentary.getCreatedAt.format("Y-m-d") }}</small>
                                    </div>
                                </div>
                                <p class="card-text">
                                    {{ commentary.text|raw }}
                                </p>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <h5 class="mt-5"><i class="text-danger font-italic">There is no commentaries on this post</i></h5>
            {% endif %}

        {% else %}
            <div class="d-flex justify-content-center align-items-start vh-100 pt-5">
                <h2><i class="text-danger font-italic">Post does not exist</i></h2>
            </div>
        {% endif %}
    </div>

{% endblock %}