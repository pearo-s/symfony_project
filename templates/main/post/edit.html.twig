{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">

        <div class="row">
            <div class="col-12">
                <h1 class="text-center h2 my-3">Post editing</h1>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'w-50 mt-5'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.text) }}
            {{ form_row(form.is_published) }}

            <div class="form-group">
            {% if postThumbnail is not empty %}
                <div class="mb-3">
                    <img src="{{ asset('uploads/post/' ~ postThumbnail) }}" alt="current_image" width="200">
                </div>
                {{ form_row(form.removeFile) }}
            {% endif %}
            </div>

            {{ form_row(form.image) }}
            {{ form_row(form.update) }}
            {{ form_row(form._token) }}

        {{ form_end(form, {'render_rest': false}) }}

    </div>
{% endblock %}
