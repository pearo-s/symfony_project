{% extends 'base.html.twig' %}

{% block body %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if settings and rates and settings.isShown %}
        {% include 'main/widgets/exchange_rate_nbkr.html.twig' %}
    {% endif %}
{% endblock %}